# Copy this file to .env in the folder where you start the app.
# You do not need it: on the first start the app asks for the URL and the token.

JIRA_URL=https://jira.example.com

# Option A: personal access token (Bearer)
JIRA_PERSONAL_TOKEN=your_token_here

# Option B: username + API token
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=your_api_token_here

# Optional (default: true)
JIRA_VERIFY_SSL=true
